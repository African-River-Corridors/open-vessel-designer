    {
      "id": "es-trin/4.01(1)/safety-clearance",
      "title": "Safety clearance at least 300 mm (checked against the freeboard to the deck edge; ES-TRIN measures to the lowest point that is not watertight, so this is the stricter reading for a vessel with openings above the deck)",
      "origin": "regulation",
      "source": {
        "document": "ES-TRIN, European standard laying down technical requirements for inland navigation vessels",
        "edition": "Edition 2025/1",
        "locator": "4.01(1)",
        "page": "ES_TRIN_2025_signed_en.pdf, Chapter 4, p. 17",
        "access": "free"
      },
      "codified": {
        "by": "agent",
        "date": "2026-10-22",
        "review": "#428"
      },
      "verified": false,
      "kind": "limit",
      "measure": {
        "id": "input.min_freeboard_m"
      },
      "compare": "ge",
      "limit": {
        "value": 0.3,
        "unit": "m"
      },
      "tolerance": 0,
